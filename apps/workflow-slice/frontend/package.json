{
  "name": "aicrm-workflow-slice",
  "version": "0.2.0-rep-integration.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "test": "npm run test:domain && npm run test:dom",
    "test:dom": "npm run build && node --test --test-reporter=tap tests/rep-integration-dom.test.mjs",
    "test:real": "node --test --test-reporter=tap tests/rep-real-api-dom.test.mjs",
    "test:domain": "node --test --test-reporter=tap tests/domain-v3/*.mjs tests/record-contract.test.mjs tests/event-draft.test.mjs"
  },
  "dependencies": {
    "vue": "3.5.22"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@vitejs/plugin-vue": "6.0.1",
    "jsdom": "^27.0.1",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vue-tsc": "3.1.1"
  }
}
